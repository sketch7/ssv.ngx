strict-peer-dependencies=false
auto-install-peers=true
shamefully-hoist=true
# Flat node_modules (no per-lib node_modules). Keeps sibling consumer workspaces
# (cosmowrench, blueprint.client) from resolving through a shadowed libs/*/node_modules
# when they link this repo's source. See tools/strip-source-condition.mjs.
node-linker=hoisted